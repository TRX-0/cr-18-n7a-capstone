"""Orion Retail stock reconciliation service (app01).

No authentication of any kind. The only thing standing between a caller and
the data is a host firewall that trusts ws01's address, which is the finding:
the service treats "came from the right IP" as though it were "is the right
caller".
"""
import http.server
import socketserver

FLAG = "{{ final_flag }}"

PAGE = """Orion Retail - stock reconciliation service
===========================================

node        : app01
environment : production
auth        : none (restricted by source address)

reconciliation token: {flag}
"""


class Service(http.server.BaseHTTPRequestHandler):
    def version_string(self):
        return "Werkzeug/2.3.7 Python/3.12.3"

    def do_GET(self):
        body = PAGE.format(flag=FLAG).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        return


class Threaded(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    Threaded(("0.0.0.0", 8080), Service).serve_forever()
