"""Orion Retail operations panel.

Small internal panel that sits in front of the transfer schedule. Basic auth
over plain HTTP, which is the finding - the credential was rotated after the
September incident but the transport was never changed, so it still crosses
the office LAN in a readable form every time somebody signs in.

Server header is forced to 'nginx' so the banner the trainee reads with
nmap -sV matches the handover capture they were given.
"""
import base64
import http.server
import socketserver

USERNAME = "{{ panel_user }}"
PASSWORD = "{{ panel_password }}"
FLAG = "{{ panel_flag }}"
REALM = "Orion Operations"

PUBLIC = """<!doctype html>
<html>
<head><title>Orion Retail</title></head>
<body>
<h1>Orion Retail Ltd</h1>
<p>Store systems portal. Staff access only.</p>
<p><a href="/admin/">Operations panel</a></p>
</body>
</html>
"""

PANEL = """<!doctype html>
<html>
<head><title>Orion Operations</title></head>
<body>
<h2>Operations Panel</h2>
<p>Signed in as {user}.</p>

<h3>Nightly transfer</h3>
<table border="1" cellpadding="4">
<tr><th>Source</th><th>Destination</th><th>Protocol</th><th>Account</th></tr>
<tr><td>ws01</td><td>fs01:/srv/sync</td><td>FTP</td><td>svc_sync</td></tr>
</table>
<p>Transfer notes and the account cleanup handover are on the fs01 drop
(anonymous FTP, still enabled pending supplier review).</p>

<h3>Panel build</h3>
<p>Deployment token: {flag}</p>
</body>
</html>
"""

UNAUTH = """<!doctype html>
<html>
<head><title>401 Unauthorized</title></head>
<body><h1>Authorization Required</h1></body>
</html>
"""


class Panel(http.server.BaseHTTPRequestHandler):
    server_version = "nginx"
    sys_version = ""

    def version_string(self):
        return "nginx"

    def _send(self, code, body, extra=None):
        payload = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html")
        self.send_header("Content-Length", str(len(payload)))
        for key, value in (extra or []):
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(payload)

    def _authorised(self):
        header = self.headers.get("Authorization", "")
        if not header.startswith("Basic "):
            return False
        try:
            decoded = base64.b64decode(header[6:]).decode()
        except Exception:
            return False
        user, _, password = decoded.partition(":")
        return user == USERNAME and password == PASSWORD

    def do_GET(self):
        path = self.path.split("?")[0]
        if path in ("/admin", "/admin/"):
            if not self._authorised():
                self._send(401, UNAUTH,
                           [("WWW-Authenticate", 'Basic realm="%s"' % REALM)])
                return
            self._send(200, PANEL.format(user=USERNAME, flag=FLAG))
            return
        if path == "/":
            self._send(200, PUBLIC)
            return
        self._send(404, "<html><body><h1>404 Not Found</h1></body></html>\n")

    def log_message(self, *args):
        return


class Threaded(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    Threaded(("0.0.0.0", 80), Panel).serve_forever()
